# Benchmark Configuration for Fractional GPU Testing on GKE
# Edit values here or override via environment variables before running scripts.

# Required: Your Google Cloud Project ID (defaults to active gcloud project if left blank)
PROJECT_ID="${PROJECT_ID:-}"

# Region and zones supporting your target GPU machine types.
# Check available zones with:
#   gcloud compute machine-types list --filter="name=(g4-standard-12 OR g4-standard-384 OR a3-megagpu-8g)"
REGION="${REGION:-us-central1}"
GPU_ZONES="${GPU_ZONES:-us-central1-b,us-central1-c}"
G4_8GPU_ZONES="${G4_8GPU_ZONES:-us-central1-b,us-central1-c,us-central1-f}"

# Prefix applied to all GCP & Kubernetes resources and `owner` labels for easy cleanup.
# Example: export RESOURCE_PREFIX="myteam"
RESOURCE_PREFIX="${RESOURCE_PREFIX:-gpu-bench}"

# Dedicated GKE Standard test cluster (REGULAR channel >= 1.35.2 required for fractional G4).
# Set CREATE_CLUSTER=false to target an existing cluster in $REGION.
CLUSTER_NAME="${CLUSTER_NAME:-${RESOURCE_PREFIX}-cluster}"
CREATE_CLUSTER="${CREATE_CLUSTER:-true}"
RELEASE_CHANNEL="${RELEASE_CHANNEL:-regular}"

# Dedicated custom VPC avoids pod CIDR exhaustion on shared `default` VPCs.
# Set NETWORK="default" and SUBNETWORK="default" if you prefer your project's default network.
NETWORK="${NETWORK:-${RESOURCE_PREFIX}-net}"
SUBNETWORK="${SUBNETWORK:-${RESOURCE_PREFIX}-subnet}"

# Provisioning modes ("flex" = DWS Flex-start, "spot" = Spot VM, "on-demand" = standard On-Demand):
G4_PROVISIONING="${G4_PROVISIONING:-flex}"           # For g4-standard-12 baseline (supports flex / on-demand / spot)
G4_8GPU_PROVISIONING="${G4_8GPU_PROVISIONING:-spot}" # For g4-standard-384 MIG/MPS tests
H100_PROVISIONING="${H100_PROVISIONING:-flex}"       # For a3-megagpu-8g MIG/MPS tests

# Hard safety cap for DWS Flex-start node runtime (2 hours = 7200s)
FLEX_MAX_RUN_DURATION="${FLEX_MAX_RUN_DURATION:-7200s}"

# Toggle which GPU pools 01_setup_cluster_and_pools.sh creates (all start at 0 nodes)
CREATE_G4_12_POOL="${CREATE_G4_12_POOL:-true}"       # g4-standard-12 baseline
CREATE_G4_8GPU_POOLS="${CREATE_G4_8GPU_POOLS:-true}" # g4-standard-384 MIG (1g.24gb) + MPS (4/GPU)
CREATE_H100_POOLS="${CREATE_H100_POOLS:-false}"      # a3-megagpu-8g MIG (2g.20gb) + MPS (4/GPU)
CREATE_MPS_POOL="${CREATE_MPS_POOL:-true}"

# Node pool names (all prefixed with $RESOURCE_PREFIX)
G4_POOL_NAME="${G4_POOL_NAME:-${RESOURCE_PREFIX}-g4-flex}"
G4_8GPU_MIG_POOL_NAME="${G4_8GPU_MIG_POOL_NAME:-${RESOURCE_PREFIX}-g4-8gpu-mig}"
G4_8GPU_MPS_POOL_NAME="${G4_8GPU_MPS_POOL_NAME:-${RESOURCE_PREFIX}-g4-8gpu-mps}"
H100_MIG_POOL_NAME="${H100_MIG_POOL_NAME:-${RESOURCE_PREFIX}-h100-mega-mig}"
H100_MPS_POOL_NAME="${H100_MPS_POOL_NAME:-${RESOURCE_PREFIX}-h100-mega-mps}"

# Fractionalization settings
G4_8GPU_MIG_PROFILE="${G4_8GPU_MIG_PROFILE:-1g.24gb}"          # 4 slices/GPU x 8 GPUs = 32 slices/node
G4_8GPU_MPS_CLIENTS_PER_GPU="${G4_8GPU_MPS_CLIENTS_PER_GPU:-4}" # 4 clients/GPU x 8 GPUs = 32 pods/node
H100_MIG_PROFILE="${H100_MIG_PROFILE:-2g.20gb}"                # 3 slices/GPU x 8 GPUs = 24 slices/node
H100_MPS_CLIENTS_PER_GPU="${H100_MPS_CLIENTS_PER_GPU:-4}"      # 4 clients/GPU x 8 GPUs = 32 pods/node

# Container image: PyTorch 2.8 + CUDA 12.8 supports both Hopper (sm_90, H100)
# and Blackwell (sm_120, RTX PRO 6000 / G4).
# Alternative: nvcr.io/nvidia/pytorch:25.06-py3 (or an Artifact Registry mirror).
BENCH_IMAGE="${BENCH_IMAGE:-pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime}"

# MatMul HPC workload parameters (identical across every slice for apples-to-apples comparison)
MATMUL_N="${MATMUL_N:-8192}"            # Matrix dimension N x N
WARMUP_ITERS="${WARMUP_ITERS:-5}"
ITERS_FP64="${ITERS_FP64:-20}"          # Double precision (classic HPC)
ITERS_FP32="${ITERS_FP32:-50}"          # Strict IEEE FP32 (TF32 disabled)
ITERS_BF16="${ITERS_BF16:-100}"         # Tensor Core mixed precision
TARGET_VRAM_GB="${TARGET_VRAM_GB:-10}"  # Resident working-set buffer (GB) to simulate solver VRAM
CPU_PHASE_SEC="${CPU_PHASE_SEC:-0.0}"   # Optional CPU phase between GPU steps (e.g., 0.5 to test MPS burst)

# Noisy-neighbor OOM isolation test allocation (exceeds 24 GB G4 / 20 GB H100 MIG slice)
OOM_ALLOC_GB="${OOM_ALLOC_GB:-28}"

K8S_NAMESPACE="${K8S_NAMESPACE:-${RESOURCE_PREFIX}}"

# Resolve PROJECT_ID from active gcloud config if not explicitly provided
if [[ -z "${PROJECT_ID}" ]]; then
  PROJECT_ID="$(gcloud config get-value project 2>/dev/null || true)"
fi
